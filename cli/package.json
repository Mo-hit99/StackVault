{
  "name": "gexra",
  "version": "1.0.7",
  "description": "Gexra - A modern version control system with CLI and web interface",
  "keywords": [
    "gexra",
    "stackvault",
    "stack-vault",
    "vcs",
    "version-control",
    "source-control",
    "git",
    "git-like",
    "cli",
    "developer-tools",
    "repository",
    "cloud-version-control"
  ],
  "type": "module",
  "bin": {
    "gexra": "dist/bin/gexra.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "watch": "node ./node_modules/typescript/bin/tsc -w",
    "start": "node dist/bin/gexra.js",
    "link": "npm link"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.2",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^6.0.2"
  }
}
